# Development defaults for infra/compose/compose.yml.
#
# You do not need this file: every value below is already the default in compose.yml.
# Copy it to `.env` (same folder; git ignores it) only to change a value, for example
# when a port or a password clashes with something else on your machine.
#
# After changing a database user or password run `make reset`: the init script that
# creates the users runs only when the database volume is first created.

# PostgreSQL superuser: used by the init script and by `make seed`, never by the application
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coop_erp

# Flyway connects as this user (owns the database; DDL)
MIGRATION_DB_USER=coop_migrator
MIGRATION_DB_PASSWORD=coop_migrator

# The application connects as this user (member of app_rw; row-level security applies)
APP_DB_USER=coop_app
APP_DB_PASSWORD=coop_app

RABBITMQ_USER=coop
RABBITMQ_PASSWORD=coop

MINIO_ROOT_USER=coopminio
MINIO_ROOT_PASSWORD=coopminio-dev

# Keycloak admin console (http://localhost:8085/admin). The three application logins
# (fed-admin, mpcs-admin, cashier; password dev) live in realm-dev.json.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
