# Every variable of the demo server's /opt/coop-erp/.env (infra/deploy/README.md).
#
# You do not write this file: bootstrap.sh generates .env on the first run, with strong random
# values (openssl) and a new till signing key pair, and never overwrites it afterwards. This file
# explains the variables; every value below is a PLACEHOLDER. Never commit a real .env.
#
# Keep a copy of the real .env somewhere safe, apart from the server: a database backup cannot be
# used without the passwords and the signing key that go with it.

# ---- the server ----------------------------------------------------------------------------

# small (2 vCPU / 4 GB) or medium (4 vCPU / 8 GB): which resources-<size>.yml the scripts use.
COOP_ERP_SIZE=small

# The address testers open, with https://. Set by bootstrap.sh from --ip (an sslip.io name such
# as https://203-0-113-5.sslip.io, or https://203.0.113.5 with --tls internal) or --domain.
# Keycloak's hostname, the realm's redirect addresses, the web client's /config.js, the backend's
# issuer and pre-signed URLs, and the Mail link are all derived from it. To change it, run
# bootstrap.sh again with the new --ip/--domain (it updates these lines and the running realm).
PUBLIC_URL=https://203-0-113-5.sslip.io

# What Caddy serves: the same address as PUBLIC_URL.
CADDY_SITE=https://203-0-113-5.sslip.io

# How Caddy gets its certificate: an e-mail address (Let's Encrypt, which writes to it before a
# certificate expires; needs port 80 open to the internet) or the word internal (Caddy's own
# authority; browsers warn once).
CADDY_TLS=admin@example.com

# The e-mail address given to bootstrap.sh with --email (kept for a later change of address).
ACME_EMAIL=admin@example.com

# Where the images come from, and which tag. CI publishes the commit's SHA (and `main`) for every
# green commit of main. You do not edit IMAGE_TAG: deploy.sh (and bootstrap.sh) set it to the
# commit the clone is at, once CI has published it, and keep the tag it replaced in
# PREVIOUS_IMAGE_TAG (SETUP section 7, "Going back"); restore.sh sets it to the version that made
# the backup. A bootstrap with --no-pull (a laptop test) keeps whatever is here.
REGISTRY=ghcr.io/knoweb/coop_erp
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
PREVIOUS_IMAGE_TAG=

# ---- people --------------------------------------------------------------------------------

# The password of EVERY user of the demo realm (fed-admin, fed-sales, m101-manager ... the users
# of docs/DEMO.md). Give it to the testers. Generated as Demo-<12 hex characters> (a server
# bootstrapped before 6 October 2026 keeps its shorter one). demo-data.sh --repair-users puts
# every demo user back to it.
DEMO_PASSWORD=Demo-0000placeholder

# Keycloak's administrator. The console is not on the internet: through an SSH tunnel,
# ssh -L 8081:127.0.0.1:8081 root@<server>, then http://localhost:8081/auth/admin/.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-placeholder

# The confidential client the backend manages users through (coop-erp-backend in the realm).
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me-placeholder

# The mail catcher's sign-in (https://<address>/mail/), and the sender of the demo's mails.
MAIL_USER=mail
MAIL_PASSWORD=change-me-placeholder
MAIL_FROM=notifications@coop-erp.test

# ---- inside the server (nobody types these) ------------------------------------------------

# PostgreSQL: the superuser (seeds, backups), Flyway's owner of the schemas, the application,
# the outbox relay, and Keycloak's own database user.
POSTGRES_PASSWORD=change-me-placeholder
MIGRATION_DB_PASSWORD=change-me-placeholder
APP_DB_PASSWORD=change-me-placeholder
RELAY_DB_PASSWORD=change-me-placeholder
KEYCLOAK_DB_PASSWORD=change-me-placeholder

# RabbitMQ (user coop) and MinIO's root (user coopminio: the buckets, backups and restores).
RABBITMQ_PASSWORD=change-me-placeholder
MINIO_ROOT_PASSWORD=change-me-placeholder

# The backend's own MinIO user (made by minio-init, with a policy on the four buckets only; it
# cannot delete a bucket or lift the lock of audit-anchors). Added once to an older .env by
# deploy.sh or bootstrap.sh, never regenerated.
MINIO_APP_USER=coop-erp-app
MINIO_APP_PASSWORD=change-me-placeholder

# The HMAC secret of the idempotency store (application.yml, coop-erp.idempotency.hash-secret).
COOP_ERP_IDEMPOTENCY_SECRET=change-me-placeholder

# The AES-256 key that seals pending notifications: base64 of 32 random bytes.
COOP_ERP_NOTIFICATION_KEY=change-me-placeholder-base64-32-bytes

# The HMAC key of the recipient hash on the notification log (coop-erp.notification.recipient-hash-key):
# base64 of 32 random bytes, its own key, never rotated outside a maintenance window. deploy.sh
# adds one to a server bootstrapped before it existed.
COOP_ERP_NOTIFICATION_RECIPIENT_KEY=change-me-placeholder-base64-32-bytes

# The till snapshot signing key pair (Ed25519; PKCS#8 and X.509, base64), generated for this
# server. Tills enrolled here trust this key; a new key means enrolling them again.
SYNC_SIGNING_PRIVATE_KEY=change-me-placeholder
SYNC_SIGNING_PUBLIC_KEY=change-me-placeholder

# ---- backups (backup.sh) -------------------------------------------------------------------

# How many dumps of each database to keep in /opt/coop-erp/backups.
BACKUP_KEEP=14

# Optional: also upload every dump to an S3-compatible bucket (DigitalOcean Spaces, Contabo
# Object Storage, AWS S3 ...). Leave BACKUP_S3_BUCKET empty to keep backups on the server only.
# Example endpoint for Spaces in Singapore: https://sgp1.digitaloceanspaces.com
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
