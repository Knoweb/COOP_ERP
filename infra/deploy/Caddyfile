# The front door of a demo server (infra/deploy/README.md): the only container with ports open to
# the internet (80 and 443). One address, one certificate, and these paths behind it:
#
#   /              the web back office (the files in /srv of the web image)
#   /config.js     the web client's addresses, from this server's environment (below)
#   /api/...       the backend (the /api prefix is stripped: the backend serves /v1/...)
#   /auth/...      Keycloak: the coop realm and the theme files only (KC_HTTP_RELATIVE_PATH)
#   /mail/...      Mailpit, the demo's mail catcher (its own sign-in: MAIL_USER, MAIL_PASSWORD)
#   /attachments/  /images/  /packages/   the object store's buckets, for pre-signed URLs only
#
# Why paths and not subdomains: the demo is usually reached by an IP address or an sslip.io
# name, where there are no subdomains to have; and one origin means no CORS and one certificate.
#
# The values in {$...} are read from the container's environment when Caddy starts (compose.yml
# passes them from .env). CADDY_SITE is the address with its scheme (https://203-0-113-5.sslip.io,
# https://demo.example.com, https://203.0.113.5); CADDY_TLS is either an e-mail address (a real
# Let's Encrypt certificate, which needs port 80 reachable from the internet) or "internal"
# (a certificate from Caddy's own authority, which browsers warn about once).

# HTTP/1.1 and HTTP/2 only. HTTP/3 would need UDP 443 open in the firewall and published by
# Docker; without it a browser that has heard of HTTP/3 (Alt-Svc) first tries UDP and waits, and
# page loads stall. Two protocols over TCP are plenty for a demo.
{
	servers {
		protocols h1 h2
	}
}

{$CADDY_SITE} {
	tls {$CADDY_TLS}
	encode zstd gzip

	# Security headers on every answer (wave 2, DEPLOY-10). HSTS (browsers ignore it on a bare IP
	# and keep it for an sslip.io name or a domain); no MIME sniffing, so an uploaded object is
	# only ever what its content type says; no framing by another site (clickjacking of an
	# "approve" button), in the old and the new header; no full address in the Referer to other
	# sites. The `?` sets a header only when the answer has none (Keycloak and MinIO set some of
	# their own). No CSP `sandbox` on the objects: Chromium will not show a PDF in a sandboxed
	# document, and printed PDFs are opened inline from these buckets; the content-type allowlist
	# of the attachments is that control.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options nosniff
		?Content-Security-Policy "frame-ancestors 'self'"
		?X-Frame-Options SAMEORIGIN
		?Referrer-Policy strict-origin-when-cross-origin
	}

	# The web client's runtime configuration (web/src/shell/runtimeConfig.ts). Written here, from
	# PUBLIC_URL, every time the container starts, so the one published web image serves any
	# address. Never cached: a changed address must reach the next page load. stepUpAcrValues
	# stays empty: the demo realm has no level-of-assurance mapping, and a value the realm ignores
	# is not set (wave 2, the web shell decision (7)).
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.__COOP_ERP_CONFIG__ = \{ "apiBase": "{$PUBLIC_URL}/api", "oidcAuthority": "{$PUBLIC_URL}/auth/realms/coop", "oidcClientId": "coop-erp-web", "stepUpAcrValues": "" \};` 200
	}

	# The backend. Of its management endpoints only health is public (the smoke check reads it);
	# the index (/actuator), metrics and prometheus stay inside the server (DEPLOY-11). A request
	# body is capped at 8 MB here (TWK-24: the edge's line in front of the backend's own limits on
	# sync bodies; uploads go to the object store by pre-signed URL, not through /api).
	handle_path /api/* {
		request_body {
			max_size 8MB
		}
		@private {
			path /actuator /actuator/*
			not path /actuator/health /actuator/health/*
		}
		respond @private 404
		reverse_proxy backend:8080
	}

	# Keycloak (wave 2, D-3 and D-4). Its public surface is the coop realm and the theme files, an
	# allowlist: everything else under /auth answers 404 (the admin console and admin API of every
	# realm, the master realm, the welcome page). Inside coop, also 404: the account console and
	# its API (no self-service on the demo), dynamic client registration (unused), an
	# application-initiated action (kc_action on the sign-in URL, which would let a signed-in tester
	# change a shared user's password or add an OTP) and a POSTed sign-in request (the web client
	# and the tills only GET it). The sign-in form posts to login-actions, which stays open, as
	# does the forced password change of a new user (phase 4 of the demo).
	# Keycloak knows its public address from KC_HOSTNAME and reads the scheme from the
	# X-Forwarded headers Caddy sets. The console: an SSH tunnel (SETUP section 5).
	@keycloak path /auth /auth/*
	handle @keycloak {
		@kcClosed path /auth/realms/coop/account* /auth/realms/coop/clients-registrations/*
		@kcAction {
			path /auth/realms/coop/protocol/openid-connect/auth
			query kc_action=*
		}
		@kcAuthPost {
			path /auth/realms/coop/protocol/openid-connect/auth
			method POST
		}
		@kcOpen path /auth/realms/coop/* /auth/resources/*
		route {
			respond @kcClosed 404
			respond @kcAction 404
			respond @kcAuthPost 404
			reverse_proxy @kcOpen keycloak:8080
			respond 404
		}
	}

	# Mailpit serves under /mail itself (MP_WEBROOT) and asks for its own password (MP_UI_AUTH).
	redir /mail /mail/
	handle /mail/* {
		reverse_proxy mailpit:8025
	}

	# Pre-signed object URLs (attachments, printed PDFs). The backend signs them for PUBLIC_URL
	# (OBJECT_STORE_PUBLIC_ENDPOINT) in path style, /<bucket>/<key>; Caddy passes the Host header
	# on unchanged, so the signature MinIO checks is the one the backend made.
	@objects path /attachments/* /images/* /packages/*
	handle @objects {
		reverse_proxy minio:9000
	}

	# Everything else is the single-page application: a file when there is one, index.html
	# otherwise, so that a deep link survives a reload. The hashed files under /assets never
	# change; everything else is checked on every load.
	handle {
		root * /srv
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
