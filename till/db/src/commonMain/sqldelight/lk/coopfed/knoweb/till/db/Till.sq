-- The till's own database (26A section 3; CR-30-1: SQLDelight over encrypted SQLite).
-- Receipts are inserted once and never changed. An outbox row is marked acknowledged when central
-- has it and kept for the retention window (doc 32 section 3.4; S8, DR-3), so central can ask for
-- it again (RESEND_FROM). No .sqm migration before a pilot: the trial databases are re-created.

CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- The snapshot at one version, applied whole: live rows (held = 0) and rows held for a later
-- business date (held = 1). data is NULL for a held tombstone.
CREATE TABLE snapshot_row (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tbl TEXT NOT NULL,
    row_id TEXT NOT NULL,
    apply_from TEXT,
    data TEXT,
    held INTEGER NOT NULL
);

-- acked_at: epoch ms on the till's clock when central acknowledged the row; NULL while pending.
CREATE TABLE outbox (
    device_seq INTEGER NOT NULL PRIMARY KEY,
    event_id TEXT NOT NULL UNIQUE,
    event_type TEXT NOT NULL,
    json TEXT NOT NULL,
    acked_at INTEGER
);

CREATE INDEX outbox_pending ON outbox(acked_at, device_seq);

CREATE TABLE till_session (
    session_id TEXT NOT NULL PRIMARY KEY,
    is_open INTEGER NOT NULL,
    json TEXT NOT NULL
);

CREATE TABLE receipt (
    document_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    number INTEGER NOT NULL UNIQUE,
    json TEXT NOT NULL
);

CREATE INDEX receipt_session ON receipt(session_id);

-- What the office must know (TWK-05, TWK-06, TWK-07): a fact central refused, a resend the till
-- cannot serve, a counter repaired, a clock set by hand. One row per kind and fact (a NULL
-- device_seq never collides, SQLite treats NULLs as distinct).
CREATE TABLE anomaly (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    device_seq INTEGER,
    event_id TEXT,
    reason TEXT,
    detail TEXT NOT NULL,
    noted_at INTEGER NOT NULL,
    seen INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX anomaly_fact ON anomaly(kind, device_seq);

CREATE TABLE document_lines (
    line_id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    line_no INTEGER NOT NULL,
    sku_id TEXT NOT NULL,
    batch_id TEXT,
    uom_code TEXT NOT NULL,
    qty TEXT NOT NULL,
    unit_price TEXT NOT NULL,
    mrp_applied TEXT,
    control_price_applied TEXT,
    cap_reason TEXT,
    discount_rule_id TEXT,
    discount_amount TEXT,
    tax_rate_percent TEXT,
    tax_amount TEXT,
    line_total TEXT NOT NULL,
    unit_cost_at_issue TEXT,
    loss_category TEXT,
    reference_line_id TEXT,
    negative_ack INTEGER NOT NULL DEFAULT 0,
    picked INTEGER NOT NULL DEFAULT 0,
    weight_kg TEXT
);

CREATE INDEX document_lines_doc ON document_lines(document_id);

CREATE TABLE tenders (
    tender_id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    seq INTEGER NOT NULL,
    kind TEXT NOT NULL,
    amount TEXT NOT NULL,
    reference TEXT,
    customer_account_id TEXT,
    change_given TEXT,
    offline INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX tenders_doc ON tenders(document_id);

CREATE TABLE state_history (
    history_id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    from_status TEXT,
    to_status TEXT NOT NULL,
    occurred_at INTEGER NOT NULL,
    occurred_local TEXT,
    actor_user_id TEXT NOT NULL,
    reason_code TEXT,
    reason_text TEXT
);

CREATE INDEX state_history_doc ON state_history(document_id);

CREATE TABLE stock_movements (
    movement_id TEXT NOT NULL PRIMARY KEY,
    movement_seq INTEGER,
    location_id TEXT NOT NULL,
    sku_id TEXT,
    batch_id TEXT,
    lot_id TEXT,
    condition TEXT NOT NULL DEFAULT 'GOOD',
    qty_delta TEXT NOT NULL,
    movement_type TEXT NOT NULL,
    unit_cost_at_movement TEXT,
    document_id TEXT,
    document_line_id TEXT,
    occurred_at INTEGER NOT NULL,
    occurred_local TEXT,
    operator_user_id TEXT NOT NULL,
    device_id TEXT
);

CREATE INDEX stock_movements_doc ON stock_movements(document_id);
CREATE INDEX stock_movements_sku ON stock_movements(sku_id);

CREATE TABLE audit (
    audit_id TEXT NOT NULL PRIMARY KEY,
    event_type_code TEXT NOT NULL,
    occurred_at INTEGER NOT NULL,
    occurred_local TEXT,
    owner_entity_id TEXT,
    location_id TEXT,
    actor_user_id TEXT NOT NULL,
    device_id TEXT,
    till_position_id TEXT,
    subject_table TEXT,
    subject_id TEXT,
    document_id TEXT,
    before_state TEXT,
    after_state TEXT,
    reason_code TEXT,
    reason_text TEXT,
    device_seq INTEGER,
    correlation_id TEXT
);

CREATE INDEX audit_occurred ON audit(occurred_at);

CREATE TABLE cash_movements (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    amount TEXT NOT NULL,
    at INTEGER NOT NULL,
    operator_user_id TEXT NOT NULL,
    reason TEXT
);

CREATE INDEX cash_movements_session ON cash_movements(session_id);

CREATE TABLE parked_sales (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT,
    lines_json TEXT NOT NULL,
    parked_at INTEGER NOT NULL,
    operator_user_id TEXT NOT NULL,
    customer_id TEXT,
    notes TEXT
);

CREATE INDEX parked_sales_session ON parked_sales(session_id);

CREATE TABLE lot_cache (
    lot_id TEXT NOT NULL PRIMARY KEY,
    sku_id TEXT NOT NULL,
    batch_id TEXT,
    location_id TEXT NOT NULL,
    cost_price TEXT,
    selling_price TEXT,
    mrp TEXT,
    available_qty TEXT NOT NULL DEFAULT '0',
    expiry_date TEXT,
    condition TEXT NOT NULL DEFAULT 'GOOD',
    updated_at INTEGER NOT NULL
);

CREATE INDEX lot_cache_sku ON lot_cache(sku_id);

selectSetting:
SELECT value FROM setting WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);

deleteSetting:
DELETE FROM setting WHERE key = ?;

selectSnapshotRows:
SELECT tbl, row_id, apply_from, data, held FROM snapshot_row ORDER BY id;

deleteSnapshotRows:
DELETE FROM snapshot_row;

insertSnapshotRow:
INSERT INTO snapshot_row(tbl, row_id, apply_from, data, held) VALUES (?, ?, ?, ?, ?);

insertOutbox:
INSERT INTO outbox(device_seq, event_id, event_type, json) VALUES (?, ?, ?, ?);

selectPendingOutbox:
SELECT device_seq, event_id, event_type, json FROM outbox WHERE acked_at IS NULL ORDER BY device_seq LIMIT ?;

countPendingOutbox:
SELECT count(*) FROM outbox WHERE acked_at IS NULL;

acknowledgeOutboxUpTo:
UPDATE outbox SET acked_at = ? WHERE device_seq <= ? AND acked_at IS NULL;

purgeAcknowledged:
DELETE FROM outbox WHERE acked_at IS NOT NULL AND acked_at < ?;

countOutboxSeq:
SELECT count(*) FROM outbox WHERE device_seq = ?;

unacknowledgeFrom:
UPDATE outbox SET acked_at = NULL WHERE device_seq >= ?;

maxOutboxSeq:
SELECT max(device_seq) AS seq FROM outbox;

upsertSession:
INSERT OR REPLACE INTO till_session(session_id, is_open, json) VALUES (?, ?, ?);

selectOpenSession:
SELECT json FROM till_session WHERE is_open = 1 LIMIT 1;

selectSession:
SELECT json FROM till_session WHERE session_id = ?;

insertReceipt:
INSERT INTO receipt(document_id, session_id, number, json) VALUES (?, ?, ?, ?);

selectReceiptsOfSession:
SELECT json FROM receipt WHERE session_id = ? ORDER BY number;

maxReceiptNumber:
SELECT max(number) AS number FROM receipt;

insertAnomaly:
INSERT OR IGNORE INTO anomaly(kind, device_seq, event_id, reason, detail, noted_at, seen) VALUES (?, ?, ?, ?, ?, ?, ?);

selectAnomalies:
SELECT kind, device_seq, event_id, reason, detail, noted_at, seen FROM anomaly ORDER BY id DESC LIMIT ?;

countUnseenAnomalies:
SELECT count(*) FROM anomaly WHERE seen = 0;

markAnomaliesSeen:
UPDATE anomaly SET seen = 1 WHERE seen = 0;

countQuarantinedAmong:
SELECT count(*) FROM anomaly WHERE kind = 'QUARANTINED' AND device_seq IN ?;

insertDocumentLine:
INSERT INTO document_lines(
    line_id, document_id, line_no, sku_id, batch_id, uom_code, qty, unit_price,
    mrp_applied, control_price_applied, cap_reason, discount_rule_id, discount_amount,
    tax_rate_percent, tax_amount, line_total, unit_cost_at_issue, loss_category,
    reference_line_id, negative_ack, picked, weight_kg
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectDocumentLinesByDocument:
SELECT * FROM document_lines WHERE document_id = ? ORDER BY line_no;

insertTender:
INSERT INTO tenders(
    tender_id, document_id, seq, kind, amount, reference, customer_account_id, change_given, offline
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTendersByDocument:
SELECT * FROM tenders WHERE document_id = ? ORDER BY seq;

insertStateHistory:
INSERT INTO state_history(
    history_id, document_id, from_status, to_status, occurred_at, occurred_local, actor_user_id, reason_code, reason_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectStateHistoryByDocument:
SELECT * FROM state_history WHERE document_id = ? ORDER BY occurred_at;

insertStockMovement:
INSERT INTO stock_movements(
    movement_id, movement_seq, location_id, sku_id, batch_id, lot_id, condition, qty_delta,
    movement_type, unit_cost_at_movement, document_id, document_line_id, occurred_at,
    occurred_local, operator_user_id, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectStockMovementsByDocument:
SELECT * FROM stock_movements WHERE document_id = ? ORDER BY occurred_at;

insertAuditEvent:
INSERT INTO audit(
    audit_id, event_type_code, occurred_at, occurred_local, owner_entity_id, location_id,
    actor_user_id, device_id, till_position_id, subject_table, subject_id, document_id,
    before_state, after_state, reason_code, reason_text, device_seq, correlation_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAuditEvents:
SELECT * FROM audit ORDER BY occurred_at DESC LIMIT ?;

insertCashMovement:
INSERT INTO cash_movements(
    id, session_id, kind, amount, at, operator_user_id, reason
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectCashMovementsBySession:
SELECT * FROM cash_movements WHERE session_id = ? ORDER BY at;

insertParkedSale:
INSERT INTO parked_sales(
    id, session_id, lines_json, parked_at, operator_user_id, customer_id, notes
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectParkedSalesBySession:
SELECT * FROM parked_sales WHERE session_id = ? ORDER BY parked_at;

deleteParkedSale:
DELETE FROM parked_sales WHERE id = ?;

insertLotCache:
INSERT OR REPLACE INTO lot_cache(
    lot_id, sku_id, batch_id, location_id, cost_price, selling_price, mrp, available_qty, expiry_date, condition, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectLotCacheBySku:
SELECT * FROM lot_cache WHERE sku_id = ? AND available_qty > '0';

deleteLotCache:
DELETE FROM lot_cache;
