# Binary documents and assets: Git must never apply line-ending conversion to these.
# (Git misdetects the reportlab-generated PDFs as text; with core.autocrlf=true that would corrupt them.)
*.pdf      binary
*.docx     binary
*.xlsx     binary
*.pptx     binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jar      binary
*.apk      binary
*.aab      binary
*.keystore binary

# Markdown, text extracts and shell scripts are LF on every platform, so extracts
# regenerated on Windows, Linux or macOS compare equal and scripts run under bash.
*.md  text eol=lf
*.txt text eol=lf
*.sh  text eol=lf
# Git hooks are shell scripts without an extension; with CRLF the shebang line breaks.
.githooks/** text eol=lf

# Files that are read inside Linux containers or by make must be LF on every platform:
# a CRLF gradlew or Dockerfile does not run, and make recipes break on a trailing CR.
Makefile    text eol=lf
Dockerfile  text eol=lf
gradlew     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf

# Generated by ArchitectureTests and compared by the pipeline: the same bytes on every platform.
docs/modules/** text eol=lf
*.adoc       text eol=lf

# Generated TypeScript clients, compared by the pipeline.
web/src/generated/** text eol=lf
